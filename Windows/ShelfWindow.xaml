<Window x:Class="SATF.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SATF"
        Width="380" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">
    <Border Background="#F21E1E26" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="AppLogo" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="✕" Width="26" Height="26" Background="#22FFFFFF" Foreground="#AAA"
                        BorderThickness="0" Cursor="Hand" Click="OnCloseClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="13"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- File List or Empty Drop Placeholder -->
            <Border Grid.Row="1" Background="#11FFFFFF" CornerRadius="10" BorderBrush="#44FFFFFF"
                    BorderThickness="1.5" Margin="0,0,0,12" AllowDrop="True"
                    DragOver="OnListDragOver" Drop="OnListDrop">
                <Grid>
                    <ListBox x:Name="FileListBox" Background="Transparent" BorderThickness="0"
                             Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="OnListPreviewMouseDown"
                             MouseMove="OnListMouseMove">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="White"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="✕" FontSize="10" Width="18" Height="18"
                                            Background="Transparent" Foreground="#888" BorderThickness="0"
                                            Tag="{Binding Path}" Click="OnRemoveFileClick"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty placeholder -->
                    <StackPanel x:Name="EmptyPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="EmptyTitle" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" FontSize="11" Foreground="#666" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="CopyAllButton" Grid.Column="0" Height="34" Margin="0,0,6,0"
                        Background="#334A90E2" Foreground="White" BorderThickness="0"
                        FontWeight="Medium" Cursor="Hand" Click="OnCopyAllClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="ClearButton" Grid.Column="1" Height="34" Margin="6,0,0,0"
                        Background="#22FF4444" Foreground="#FF9999" BorderThickness="0"
                        FontWeight="Medium" Cursor="Hand" Click="OnClearAllClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>

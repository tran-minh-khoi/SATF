# Đổi tên file này thành upload.env (cùng thư mục) rồi điền 2 dòng dưới.
# Lấy ở App Store Connect → Users and Access → Integrations → App Store Connect API.
# File khoá AuthKey_<KEY_ID>.p8 đặt trong ~/.appstoreconnect/private_keys/
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

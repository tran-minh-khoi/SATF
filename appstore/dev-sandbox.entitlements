<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Chỉ dùng cho scripts/run-dev.sh (APPSTORE=1): sandbox như bản App Store, ký ad-hoc nên không có App ID -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- Thư mục lưu file kết quả do người dùng tự chọn trong Cài đặt -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Giữ quyền thư mục đã chọn qua các lần mở app -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <!-- Nơi lưu mặc định: Downloads -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
</dict>
</plist>
